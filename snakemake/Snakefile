            --sqlite-cache {params.sqlite_cache}
        
        echo "ok" > {output.done}
       
        """


# generate the sequence database and merge figures from the merged pangenome
rule postprocess_pangenome:
    input:
        graphs=RESULTS / "pangenomes" / "pangenomes.tsv",
        done=RESULTS / "pangenomerge" / "done.txt",
    output:
        seqdb=RESULTS / "pangenomerge" / "pangenome_sequences.sqlite",
        merge_stats=RESULTS / "pangenomerge" / "postprocessing" / "merge_statistics.csv",
    params:
        pangenomerge_dir=RESULTS / "pangenomerge",
        postprocess_runner=config["pangenomerge_postprocess_runner"],
    conda:
        "envs/pangenomerge.yaml"
    threads: config["resources_pangenomerge"]["threads"]
    resources:
        mem=config["resources_pangenomerge"]["mem"],
        runtime=config["resources_pangenomerge"]["runtime"],
        nodes=config["resources_pangenomerge"]["nodes"],
        slurm_partition=config["resources_pangenomerge"]["slurm_partition"],
    log:
        str(LOGDIR / "postprocess_pangenome.log"),
    shell:
        r"""

        mkdir -p "$(dirname "{log}")"
        exec > >(tee -a "{log}") 2>&1

        echo "[postprocess_pangenome] start: $(date -Is)"

        # per-gene sequence database, required by pangenomerge-msa
        python3 {params.postprocess_runner} \
            --pangenomerge-results {params.pangenomerge_dir} \
            --output sequences \
            --component-graphs {input.graphs}

        # merge statistics and plots
        python3 {params.postprocess_runner} \
            --pangenomerge-results {params.pangenomerge_dir} \
            --output figures

        echo "[postprocess_pangenome] done: $(date -Is)"

        """


# per-gene codon MSAs, in both strict and non-strict modes.
# --codons and --strict-codons produce identical aligned_protein_sequences/ and
# unaligned_dna_sequences/, so both runs share one --shared-alignment-dir and the
# (expensive) protein alignment happens once. They diverge only for genes with
# QC-failing DNA, which is why aligned_gene_sequences/ stays per-mode.
# One shard of the msa sequence extraction. Writes per-gene protein and DNA
# inputs into the shared alignment directory (distinct files per gene, so the
# shards never collide); rule msa then finds them and skips its own serial
# extraction. Output is a sentinel, not the files: a failed shard must not make
# snakemake delete what the other shards wrote.
rule msa_extract:
    input:
        seqdb=RESULTS / "pangenomerge" / "pangenome_sequences.sqlite",
    output:
        done=RESULTS / "msa" / "extract" / "shard_{shard}.done",
    params:
        msadir=RESULTS / "msa",
        pangenomerge_dir=RESULTS / "pangenomerge",
        msa_runner=config["pangenomerge_msa_runner"],
        shards=MSA_SHARDS,
    conda:
        "envs/pangenomerge.yaml"
    threads: MSA_EXTRACT_RESOURCES["threads"]
    resources:
        mem=MSA_EXTRACT_RESOURCES["mem"],
        runtime=MSA_EXTRACT_RESOURCES["runtime"],
        nodes=MSA_EXTRACT_RESOURCES["nodes"],
        slurm_partition=MSA_EXTRACT_RESOURCES["slurm_partition"],
    log:
        str(LOGDIR / "msa_extract" / "shard_{shard}.log"),
    shell:
        r"""

        mkdir -p "$(dirname "{log}")"
        exec > >(tee -a "{log}") 2>&1

        echo "[msa_extract] start: $(date -Is) shard={wildcards.shard}/{params.shards} procs={threads}"
        mkdir -p {params.msadir}/alignment {params.msadir}/codon "$(dirname {output.done})"

        # same --outdir/--alignment-outdir/--shared-alignment-dir as rule msa's
        # codon pass, so the files land exactly where that pass looks for them
        python3 {params.msa_runner}             --outdir {params.pangenomerge_dir}             --alignment-outdir {params.msadir}/codon             --shared-alignment-dir {params.msadir}/alignment             --alignment pan --codons             --extract-only --shard {wildcards.shard}/{params.shards}             --extract-procs {threads} --immutable-db             --verbose

        echo "ok" > {output.done}
        echo "[msa_extract] done: $(date -Is)"
        """


rule msa:
    input:
        seqdb=RESULTS / "pangenomerge" / "pangenome_sequences.sqlite",
        # pre-extracted inputs from the sharded jobs (see rule msa_extract)
        extracted=expand(str(RESULTS / "msa" / "extract" / "shard_{shard}.done"),
                         shard=range(MSA_SHARDS)),
    output:
        done=RESULTS / "msa" / "done.txt",
    params:
        # not a directory() output on purpose: snakemake removes those on failure,
        # which would delete exactly the partial alignments --resume exists to reuse
        msadir=RESULTS / "msa",
        pangenomerge_dir=RESULTS / "pangenomerge",
        msa_runner=config["pangenomerge_msa_runner"],
    conda:
        "envs/pangenomerge.yaml"
    threads: config["resources_pangenomerge"]["threads"]
    resources:
        mem=config["resources_pangenomerge"]["mem"],
        runtime=config["resources_pangenomerge"]["runtime"],
        nodes=config["resources_pangenomerge"]["nodes"],
        slurm_partition=config["resources_pangenomerge"]["slurm_partition"],
    log:
        str(LOGDIR / "msa.log"),
    shell:
        r"""

        mkdir -p "$(dirname "{log}")"
        exec > >(tee -a "{log}") 2>&1

        echo "[msa] start: $(date -Is)"
        echo "[msa] threads: {threads}"

        SHARED={params.msadir}/alignment
        mkdir -p "$SHARED"

        # non-strict first: it populates the shared protein alignments, which the
        # strict pass then reuses instead of running MAFFT a second time
        for mode in codon codon_strict; do
            case $mode in
                codon)        FLAG=--codons ;;
                codon_strict) FLAG=--strict-codons ;;
            esac

            OUT={params.msadir}/$mode
            mkdir -p "$OUT"

            # --resume is only valid when a manifest from an interrupted run exists
            RESUME=""
            if [ -f "$OUT/alignment_resume_state.json" ]; then
                RESUME="--resume"
                echo "[msa] $mode: resuming from existing manifest"
            fi

            echo "[msa] $mode: start $(date -Is)"
            python3 {params.msa_runner} \
                --outdir {params.pangenomerge_dir} \
                --alignment-outdir "$OUT" \
                --shared-alignment-dir "$SHARED" \
                --alignment pan \
                $FLAG $RESUME \
                --threads {threads} \
                --verbose
            echo "[msa] $mode: done $(date -Is)"
        done

        echo "ok" > {output.done}
        echo "[msa] done: $(date -Is)"

        """
